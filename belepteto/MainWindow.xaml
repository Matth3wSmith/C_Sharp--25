<Window x:Class="belepteto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:belepteto"
        mc:Ignorable="d"
        Title="Beléptető" MinHeight="400" Width="800" SizeToContent="Height">


    <Window.Resources>
        <Style TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Style.Resources>
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="DarkRed" />
            <Setter Property="Background" Value="DarkRed" />
            <Setter Property="Foreground" Value="White" />
            
            <Style.Triggers>
                <!--Hover-->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Height="50" Background="#FF980B0B" >
            <Border BorderBrush="#700307" BorderThickness="0,0,0,2">
                <Border.Effect>
                    <DropShadowEffect
                        Color="Black"
                        BlurRadius="10"
                        ShadowDepth="4"
                        Opacity="0.8"/>
                </Border.Effect>
                <TextBlock Text="Beléptető rendszer" FontFamily="Cascadia Mono" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>

            </Border>

            
        </Grid>

        <Grid Grid.Row="1" Name="FoGrid" Background="#FFB10E0E"/>



        <!--
            <Border BorderThickness="10,10,10,10" Margin="69,75,565,200" CornerRadius="5,5,5,5">
                <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF320A8E"/>
                    <GradientStop Color="#FF2A57C7" Offset="1"/>
                    <GradientStop Color="#FF0E36B1" Offset="0.63"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border BorderBrush="Black" BorderThickness="1">
                <Grid Name="Feladat2">
                    <Label Content="2. feladat" Name="feladat2" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Border>
        -->
    </Grid>
    
</Window>
    
