<Window x:Class="wpf_gyak3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf_gyak3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid x:Name="MainGrid">
        
        <Grid.RowDefinitions>
            
            <!-- Felső rész: vezérlők -->
            <RowDefinition Height="Auto"/>
            
            <!-- Alsó rész: dinamikus táblázat -->
            <RowDefinition Height="*"/>
            
        </Grid.RowDefinitions>
        
        <!-- FELSŐ RÉSZ -->
        
            <TextBox x:Name="Szoveg" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="TextBox_TextChanged"/>
            <Button x:Name="Gomb" Content="Történjen már valami" HorizontalAlignment="Left" Margin="10,33,0,0" VerticalAlignment="Top" Width="120" Click="Button_Click"/>
            <Button Content="Ablak nyitása" HorizontalAlignment="Left" Margin="10,61,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
        
        
        <!-- ALSÓ RÉSZ -->
        <Grid x:Name="TableGrid"
          Grid.Row="1"/>
    </Grid>
</Window>
