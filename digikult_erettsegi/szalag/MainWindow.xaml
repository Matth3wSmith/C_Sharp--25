<Window x:Class="szalag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:szalag"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="#FF2F805D"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl>
            <TabItem Header="2. feladat">
                <Grid>
                    <TextBlock HorizontalAlignment="Left" Margin="79,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="hu-hu" Text="Add meg egy szállítás sorszámát:"/></TextBlock>
                    <TextBox x:Name="F2" HorizontalAlignment="Left" Margin="424,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="121" Height="22"/>
                    <Button Content="Lekérés" HorizontalAlignment="Left" Margin="608,58,0,0" VerticalAlignment="Top" Height="27" Width="59" Click="Button_Click"/>
                    <TextBlock x:Name="Valasz" HorizontalAlignment="Center" Margin="0,143,0,0" TextAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="30" Width="379"/>
                </Grid>
            </TabItem>
            <TabItem Header="3. feladat">
                <Grid>
                    <TextBlock x:Name="Max" HorizontalAlignment="Left" Margin="64,58,0,0" TextWrapping="Wrap" VerticalAlignment="Top"><Run Language="hu-hu" Text="A "/><Run Text=" legnagyobb távolság: "/></TextBlock>
                    <TextBlock x:Name="Maxok" HorizontalAlignment="Left" Margin="64,100,0,0" TextWrapping="Wrap" Text="A maximális távolságú szállítások sorszáma:" VerticalAlignment="Top"/>
                    <Button Content="Lekérés" HorizontalAlignment="Center" Margin="0,171,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
